aws_region         = "ap-south-1"
cluster_name       = "taskmanager-devops-lab"
kubernetes_version = "1.34" # Confirm this version is currently supported in your selected AWS region.
enable_nat_gateway = true
node_instance_type = "t3.medium"
node_min_size      = 1
node_desired_size  = 1
node_max_size      = 2
