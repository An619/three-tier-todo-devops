# Copy to .env and replace every example value with unique local-only secrets.
FRONTEND_PORT=3000
AUTH_DB_ROOT_PASSWORD=replace-with-long-random-auth-root-password
AUTH_DB_PASSWORD=replace-with-long-random-auth-app-password
TASK_DB_ROOT_PASSWORD=replace-with-long-random-task-root-password
TASK_DB_PASSWORD=replace-with-long-random-task-app-password
# Must be the same for auth-service and task-service; at least 32 random characters.
JWT_SECRET=replace-with-random-secret-at-least-32-characters
JWT_TTL_SECONDS=3600
