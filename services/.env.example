# Copy to .env in the services directory and use unique local-only passwords.
FRONTEND_PORT=3000
AUTH_DB_ROOT_PASSWORD=replace-with-long-random-root-password
AUTH_DB_PASSWORD=replace-with-long-random-app-password
TASK_DB_ROOT_PASSWORD=replace-with-another-long-random-root-password
TASK_DB_PASSWORD=replace-with-another-long-random-app-password
# Use the same secret for auth-service and task-service; at least 32 random characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_TTL_SECONDS=3600
